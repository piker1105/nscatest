import React, { useState, useEffect } from 'react';
import { Plus, Trash2, Printer, Download, FileText } from 'lucide-react';

const PaymentRequestGenerator = () => {
  const [meta, setMeta] = useState({
    applicant: '',
    date: new Date().toISOString().split('T')[0],
    paymentMethod: 'transfer',
    note: ''
  });

  const initialItem = {
    id: 1,
    date: new Date().toISOString().split('T')[0],
    dept: '運釀',
    category: '',
    client: '',
    projectId: '',
    projectName: '',
    description: '',
    amount: ''
  };

  const [items, setItems] = useState([initialItem]);

  useEffect(() => {
    const savedName = localStorage.getItem('applicant_name');
    if (savedName) {
      setMeta(prev => ({ ...prev, applicant: savedName }));
    }
  }, []);

  const handleMetaChange = (field, value) => {
    setMeta(prev => ({ ...prev, [field]: value }));
    if (field === 'applicant') {
      localStorage.setItem('applicant_name', value);
    }
  };

  const handleItemChange = (id, field, value) => {
    setItems(prev => prev.map(item => 
      item.id === id ? { ...item, [field]: value } : item
    ));
  };

  const addItem = () => {
    const newItem = {
      ...initialItem,
      id: Math.max(...items.map(i => i.id), 0) + 1,
      date: meta.date
    };
    setItems([...items, newItem]);
  };

  const removeItem = (id) => {
    if (items.length === 1) return;
    setItems(items.filter(item => item.id !== id));
  };

  const totalAmount = items.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);

  // 手動觸發列印功能
  const handlePrint = (e) => {
    e.preventDefault();
    window.print();
  };

  const downloadCSV = () => {
    const headers = ['編號', '付款日期', '部門', '類別', '客戶別', '專案編號', '專案名稱', '內容/備註', '金額'];
    const csvContent = [
      headers.join(','),
      ...items.map((item, idx) => [
        idx + 1,
        item.date,
        item.dept,
        item.category,
        item.client,
        item.projectId,
        item.projectName,
        `"${item.description.replace(/"/g, '""')}"`,
        item.amount
      ].join(','))
    ].join('\n');

    const blob = new Blob(['\ufeff' + csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', `請款單_${meta.applicant}_${meta.date}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  return (
    <div className="min-h-screen bg-gray-100 font-sans text-gray-800">
      
      {/* 控制列 */}
      <div className="bg-white shadow-sm border-b p-4 print:hidden sticky top-0 z-10 flex flex-wrap justify-between items-center gap-4">
        <div className="flex items-center gap-2">
          <FileText className="text-blue-600" />
          <h1 className="text-xl font-bold">請款單產生系統 (橫式 A4)</h1>
        </div>
        <div className="flex gap-3">
          <button onClick={addItem} className="flex items-center gap-2 px-4 py-2 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 border border-green-200">
            <Plus size={18} /> 新增項目
          </button>
          <button onClick={downloadCSV} className="flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 border border-gray-300">
            <Download size={18} /> 下載 CSV
          </button>
          <button onClick={handlePrint} className="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 shadow-sm">
            <Printer size={18} /> 列印 / PDF
          </button>
        </div>
      </div>

      <div className="flex flex-col lg:flex-row gap-6 p-6 print:p-0">
        
        {/* 輸入編輯區 */}
        <div className="w-full lg:w-1/3 space-y-6 print:hidden">
          <div className="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
            <h2 className="text-lg font-semibold mb-4 border-b pb-2">1. 基本資料</h2>
            <div className="grid grid-cols-1 gap-4">
              <div>
                <label className="block text-sm font-medium mb-1">請款人姓名</label>
                <input type="text" value={meta.applicant} onChange={(e) => handleMetaChange('applicant', e.target.value)} className="w-full p-2 border rounded" />
              </div>
              <div>
                <label className="block text-sm font-medium mb-1">付款日期</label>
                <input type="date" value={meta.date} onChange={(e) => handleMetaChange('date', e.target.value)} className="w-full p-2 border rounded" />
              </div>
              <div>
                <label className="block text-sm font-medium mb-1">付款方式</label>
                <select value={meta.paymentMethod} onChange={(e) => handleMetaChange('paymentMethod', e.target.value)} className="w-full p-2 border rounded">
                  <option value="cash">現金</option>
                  <option value="transfer">轉帳</option>
                  <option value="other">其他</option>
                </select>
              </div>
            </div>
          </div>

          <div className="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
            <h2 className="text-lg font-semibold mb-4 border-b pb-2">2. 消費明細</h2>
            <div className="space-y-4">
              {items.map((item, idx) => (
                <div key={item.id} className="bg-gray-50 p-4 rounded-lg border relative group">
                  <button onClick={() => removeItem(item.id)} className="absolute top-2 right-2 text-gray-400 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-opacity"><Trash2 size={16} /></button>
                  <div className="text-xs font-bold text-gray-400 mb-2">項次 {idx + 1}</div>
                  <div className="grid grid-cols-2 gap-3 mb-3">
                    <input type="date" value={item.date} onChange={(e) => handleItemChange(item.id, 'date', e.target.value)} className="p-1.5 text-sm border rounded" />
                    <input type="number" value={item.amount} onChange={(e) => handleItemChange(item.id, 'amount', e.target.value)} className="p-1.5 text-sm border rounded font-mono [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" placeholder="金額 (含稅)" />
                  </div>
                  <div className="grid grid-cols-2 gap-3 mb-3">
                    <input type="text" value={item.projectId} onChange={(e) => handleItemChange(item.id, 'projectId', e.target.value)} className="p-1.5 text-sm border rounded" placeholder="專案編號" />
                    <select value={item.category} onChange={(e) => handleItemChange(item.id, 'category', e.target.value)} className="p-1.5 text-sm border rounded bg-white">
                      <option value="">選擇類別...</option>
                      <option value="餐飲">餐飲</option>
                      <option value="交通">交通/運送</option>
                      <option value="職工福利">職工福利</option>
                      <option value="文具">文具/消耗品</option>
                      <option value="設備">設備/維修</option>
                      <option value="應酬">應酬禮品</option>
                      <option value="其他">其他</option>
                    </select>
                  </div>
                  <textarea value={item.description} onChange={(e) => handleItemChange(item.id, 'description', e.target.value)} className="w-full p-1.5 text-sm border rounded resize-none" rows="2" placeholder="內容/備註" />
                </div>
              ))}
              <button onClick={addItem} className="w-full py-3 border-2 border-dashed border-gray-300 text-gray-500 rounded-lg hover:border-blue-400 hover:text-blue-600 transition-colors flex justify-center items-center gap-2"><Plus size={18} /> 新增一筆消費</button>
            </div>
          </div>
        </div>

        {/* 預覽與列印區 */}
        <div className="w-full lg:w-2/3 flex justify-center bg-gray-200 lg:bg-transparent print:w-full print:bg-white print:block">
          <div className="bg-white shadow-lg print:shadow-none w-full max-w-[297mm] min-h-[210mm] p-[10mm] print:p-0 text-black box-border">
            <div className="text-center mb-6">
              <h1 className="text-2xl font-bold tracking-widest mb-2">運釀股份有限公司</h1>
              <h2 className="text-xl font-medium border-b-2 border-black inline-block pb-1 px-4">員工請款單 Payment Request</h2>
            </div>

            <div className="flex justify-between items-end mb-4 text-sm">
              <div className="space-y-2 w-2/3">
                <div className="flex"><span className="font-bold w-20">請款人：</span><span className="border-b border-black w-64 px-2">{meta.applicant}</span></div>
                <div className="flex"><span className="font-bold w-20">總計金額：</span><span className="border-b border-black w-64 px-2 font-mono text-lg">{totalAmount.toLocaleString()}</span></div>
                <div className="flex items-center"><span className="font-bold w-20">付款方式：</span><div className="flex gap-4">
                    {['cash', 'transfer', 'other'].map(m => (
                      <label key={m} className="flex items-center gap-1"><span className="border border-black w-4 h-4 flex items-center justify-center">{meta.paymentMethod === m && '✓'}</span> {m === 'cash' ? '現金' : m === 'transfer' ? '轉帳' : '其他'}</label>
                    ))}
                  </div>
                </div>
              </div>
              <div className="space-y-2 w-1/3 text-right">
                <div className="flex justify-end items-center"><span className="font-bold mr-2">付款日期：</span><span className="border-b border-black w-40 text-center">{meta.date}</span></div>
                <div className="flex justify-end items-center"><span className="font-bold mr-2">編號 Ref#：</span><span className="border-b border-black w-40 text-center bg-gray-100 print:bg-transparent"></span></div>
                <div className="flex justify-end items-center mt-2"><label className="flex items-center gap-1"><span className="border border-black w-4 h-4"></span> 出帳查核</label></div>
              </div>
            </div>

            <div className="mb-6">
              <table className="w-full border-collapse border border-black text-xs table-fixed">
                <thead>
                  <tr className="bg-gray-100">
                    <th className="border border-black p-1 w-[35px]">編號</th>
                    <th className="border border-black p-1 w-[80px]">日期</th>
                    <th className="border border-black p-1 w-[50px]">部門</th>
                    <th className="border border-black p-1 w-[70px]">類別</th>
                    <th className="border border-black p-1 w-[70px]">客戶別</th>
                    <th className="border border-black p-1 w-[90px]">專案編號</th>
                    <th className="border border-black p-1 w-[110px]">專案名稱</th>
                    <th className="border border-black p-1">內容 / 備註</th>
                    <th className="border border-black p-1 w-[80px]">金額</th>
                  </tr>
                </thead>
                <tbody>
                  {items.map((item, idx) => (
                    <tr key={item.id} className="text-center align-top h-8">
                      <td className="border border-black p-1">{idx + 1}</td>
                      <td className="border border-black p-1">{item.date}</td>
                      <td className="border border-black p-1">{item.dept}</td>
                      <td className="border border-black p-1">{item.category}</td>
                      <td className="border border-black p-1">{item.client}</td>
                      <td className="border border-black p-1 break-all">{item.projectId}</td>
                      <td className="border border-black p-1 break-all">{item.projectName}</td>
                      <td className="border border-black p-1 text-left whitespace-pre-wrap">{item.description}</td>
                      <td className="border border-black p-1 text-right font-mono">{item.amount && Number(item.amount).toLocaleString()}</td>
                    </tr>
                  ))}
                  {Array.from({ length: Math.max(0, 8 - items.length) }).map((_, idx) => (
                    <tr key={`empty-${idx}`} className="h-8"><td className="border border-black p-1">{items.length + idx + 1}</td>{Array(8).fill(null).map((_, i) => <td key={i} className="border border-black p-1"></td>)}</tr>
                  ))}
                  <tr className="font-bold bg-gray-50 print:bg-white text-sm">
                    <td colSpan="8" className="border border-black p-2 text-center">總計 Total</td>
                    <td className="border border-black p-2 text-right font-mono">{totalAmount.toLocaleString()}</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div className="flex justify-around mt-8 mb-4 text-sm px-10">
              <div className="w-1/4 border-b border-black pb-1">主管：</div>
              <div className="w-1/4 border-b border-black pb-1">財務：</div>
              <div className="w-1/4 border-b border-black pb-1">收款人：</div>
            </div>

            <div className="text-[10px] text-gray-500 mt-6 pt-2 border-t border-gray-200 leading-tight">
              <div className="flex gap-4">
                <span className="font-bold text-gray-700 whitespace-nowrap">分類備註：</span>
                <div>
                    <div>部門：專案管理 / 企劃行銷 / 監測系統 / 營運行政 / 其他</div>
                    <div>類別：設備 / 郵資 / 消耗品 / 文具 / 清潔 / 維修 / 運送 / 應酬禮品 / ...</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <style>{`
        @media print {
          @page { margin: 5mm; size: A4 landscape; }
          body { background: white !important; margin: 0; padding: 0; }
          .print\\:hidden { display: none !important; }
          .print\\:block { display: block !important; }
          .print\\:w-full { width: 100% !important; }
        }
      `}</style>
    </div>
  );
};

export default PaymentRequestGenerator;
