<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
  <style>
    body { background-color: #f2efeb; padding: 20px; font-family: "Heiti TC", "Microsoft JhengHei", sans-serif; }
    .container { max-width: 500px; background: white; border-radius: 12px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
    .header-logo { text-align: center; margin-bottom: 25px; color: #5d5d5d; }
    .btn-taoxi { background-color: #8e8379; color: white; border: none; font-weight: 500; }
    .btn-taoxi:hover { background-color: #7a6f66; color: white; }
    .form-label { font-weight: bold; color: #444; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header-logo">
      <h3>陶錫工藝 Taoxi Craft</h3>
      <p class="text-muted">體驗陶與錫的手作溫度</p>
    </div>
    <form id="bookingForm">
      <div class="mb-3">
        <label class="form-label">姓名</label>
        <input type="text" class="form-control" id="userName" placeholder="請輸入姓名" required>
      </div>
      <div class="mb-3">
        <label class="form-label">電話</label>
        <input type="tel" class="form-control" id="phone" placeholder="0912-345-678" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" id="email" placeholder="接收預約資訊" required>
      </div>
      <div class="mb-3">
        <label class="form-label">預約課程</label>
        <select class="form-select" id="courseName" required>
          <option value="花草拓印陶盤">花草拓印陶盤 ($1,180)</option>
          <option value="個性化寵物碗">個性化寵物碗 ($1,580)</option>
          <option value="阿美陶偶花器">阿美陶偶花器 ($1,380)</option>
          <option value="錫光皿體驗">錫光皿體驗 ($1,380)</option>
          <option value="錫銀叉體驗">錫銀叉體驗 ($1,680)</option>
          <option value="小錫石金屬體驗">小錫石金屬體驗 ($680)</option>
          <option value="錫銀咖啡勺">錫銀咖啡勺 ($1,680)</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">上課日期</label>
        <input type="date" class="form-control" id="classDate" required>
      </div>
      <div class="mb-3">
        <label class="form-label">人數</label>
        <input type="number" class="form-control" id="count" value="1" min="1" max="10" required>
      </div>
      <div class="mb-3">
        <label class="form-label">備註</label>
        <textarea class="form-control" id="note" rows="2" placeholder="是否有特殊需求"></textarea>
      </div>
      <button type="submit" class="btn btn-taoxi w-100 py-3" id="submitBtn">立即預約</button>
    </form>
  </div>

  <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <script>
    liff.init({ liffId: "2009015302-BTFJWoRf" }).catch(err => console.error(err));

    document.getElementById('bookingForm').onsubmit = function(e) {
      e.preventDefault();
      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.innerHTML = '正在處理預約...';

      const data = {
        userName: document.getElementById('userName').value,
        phone: document.getElementById('phone').value,
        email: document.getElementById('email').value,
        courseName: document.getElementById('courseName').value,
        classDate: document.getElementById('classDate').value,
        count: document.getElementById('count').value,
        note: document.getElementById('note').value
      };

      google.script.run.withSuccessHandler(function(res) {
        alert('預約已送出！\n應付總金額：$' + res.amount.toLocaleString() + '\n請查收 Email 獲取匯款資訊。');
        liff.closeWindow();
      }).processBooking(data);
    };
  </script>
</body>
</html>
