function sendApprovalNotificationFromSheet() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const row = sheet.getActiveCell().getRow();
  
  if (row <= 1) {
    Browser.msgBox("請選擇要發送通知的預約紀錄列");
    return;
  }
  
  const data = sheet.getRange(row, 1, 1, 10).getValues()[0];
  const p = {
    realName: data[6],
    classDate: data[1],
    session: data[2],
    course: data[3],
    peopleCount: data[4],
    totalPrice: data[5],
    email: data[8],
    lineUid: data[9]
  };
  
  if (!p.lineUid) {
    Browser.msgBox("錯誤", "找不到 LINE UID", Browser.Buttons.OK);
    return;
  }
  
  const res = Browser.msgBox("確認發送", `是否發送「預約成功」通知給 ${p.realName}?`, Browser.Buttons.YES_NO);
  
  if (res === "yes") {
    sendApprovalFlex(p);
    sendApprovalEmail(p);
    Browser.msgBox("發送成功!");
  }
}

