/**
 * 處理 POST 請求（接收來自 GitHub Pages 的表單資料）
 */
function doPost(e) {
  try {
    // 處理 LINE Webhook
    if (e.postData && e.postData.contents) {
      const data = JSON.parse(e.postData.contents);
      
      // 檢查是否為 LINE 事件
      if (data.events) {
        return handleLineWebhook(data);
      }
      
      // 否則視為表單提交
      return handleFormSubmission(data);
    }
    
    // 處理 URL 參數（來自 GitHub Pages 的 fetch 請求）
    const action = e.parameter.action;
    
    if (action === 'processForm') {
      const params = JSON.parse(e.postData.contents);
      return handleFormSubmission(params);
    }
    
    return ContentService.createTextOutput('Unknown request').setMimeType(ContentService.MimeType.TEXT);
    
  } catch (err) {
    Logger.log('doPost Error: ' + err.toString());
    return ContentService.createTextOutput('Error: ' + err.toString()).setMimeType(ContentService.MimeType.TEXT);
  }
}

/**
 * 處理 LINE Webhook 事件
 */
function handleLineWebhook(data) {
  const events = data.events;
  
  if (events && events.length > 0) {
    events.forEach(event => {
      if (event.type === 'message' && event.message.type === 'text') {
        const text = event.message.text.trim();
        
        Logger.log('收到訊息: ' + text);
        
        if (text === '預約課程') {
          Logger.log('發送 LIFF URL: ' + LIFF_URL);
          replyStartBookingFlex(event.replyToken, LIFF_URL);
        }
      }
    });
  }
  
  return ContentService.createTextOutput(JSON.stringify({status: 'ok'}))
    .setMimeType(ContentService.MimeType.JSON);
}

/**
 * 處理表單提交
 */
function handleFormSubmission(params) {
  try {
    Logger.log('===== 處理表單提交 =====');
    Logger.log('收到的參數: ' + JSON.stringify(params));
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName("預約紀錄") || ss.getSheets()[0];
    
    const priceMap = {
      '花草拓印陶盤': 1180,
      '個性化寵物碗': 1580,
      '阿美陶偶花器': 1380,
      '錫光皿體驗': 1380,
      '錫銀叉體驗': 1680,
      '小錫石金屬體驗': 880,
      '錫銀咖啡勺': 1680
    };
    
    const qty = parseInt(params.peopleCount) || 0;
    const total = (priceMap[params.course] || 0) * qty;
    params.totalPrice = total;
    
    const uid = params.lineUid || params.uid || '';
    
    Logger.log('UID: ' + uid);
    Logger.log('課程: ' + params.course);
    Logger.log('總金額: ' + total);
    
    if (!uid) {
      Logger.log('❌ 錯誤：UID 為空');
      return ContentService.createTextOutput('Error: 缺少 UID').setMimeType(ContentService.MimeType.TEXT);
    }
    
    const now = new Date();
    sheet.appendRow([
      now,
      params.classDate,
      params.session,
      params.course,
      qty,
      total,
      params.realName,
      params.phone,
      params.email,
      uid
    ]);
    
    Logger.log('試算表新增成功');
    
    params.lineUid = uid;
    
    sendAdminEmail(params);
    Logger.log('管理員郵件已寄送');
    
    sendUserEmail(params);
    Logger.log('學員郵件已寄送');
    
    sendInitialFlex(params);
    Logger.log('LINE Flex Message 已發送');
    
    Logger.log('===== 處理完成 =====');
    
    return ContentService.createTextOutput('Success').setMimeType(ContentService.MimeType.TEXT);
    
  } catch (e) {
    Logger.log('處理錯誤: ' + e.toString());
    return ContentService.createTextOutput('Error: ' + e.toString()).setMimeType(ContentService.MimeType.TEXT);
  }
}

