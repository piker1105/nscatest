<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teachify 學員手動開課工具 (CORS 修正版)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .loading-spinner {
            border: 3px solid #f3f3f3;
            border-top: 3px solid #4f46e5;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
            display: inline-block;
            vertical-align: middle;
            margin-right: 8px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-slate-50 min-h-screen py-8 px-4 font-sans">
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden p-6 md:p-10 border border-slate-100">
        <!-- 標題區 -->
        <div class="mb-10 text-center">
            <div class="inline-block p-3 bg-indigo-100 rounded-full mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">冠廷老師專屬：手動開課工具</h1>
            <p class="text-slate-500 mt-2">填寫學員資料並按送出，系統將自動於 Teachify 開通權限</p>
        </div>

        <div class="grid grid-cols-1 gap-8">
            <!-- 配置區塊 -->
            <section class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                <div class="flex items-center mb-4">
                    <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">API 配置 (自動儲存)</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Teachify API Token</label>
                        <input type="password" id="apiKey" class="w-full border-slate-300 rounded-lg shadow-sm p-2.5 text-sm focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="輸入 API Key">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">GraphQL Endpoint</label>
                        <input type="text" id="endpoint" class="w-full border-slate-300 rounded-lg shadow-sm p-2.5 text-sm focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="https://school.teachify.tw/graphql">
                    </div>
                </div>
                <div class="mt-4">
                    <label class="inline-flex items-center text-xs font-medium text-slate-600">
                        <input type="checkbox" id="useProxy" checked class="form-checkbox h-3 w-3 text-indigo-600 border-gray-300 rounded">
                        <span class="ml-2">使用 CORS Proxy (若 Failed to fetch 請務必勾選)</span>
                    </label>
                </div>
            </section>

            <!-- 學員資料區塊 -->
            <section class="space-y-5">
                <div class="flex items-center">
                    <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">學員與課程資訊</h2>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">學員姓名</label>
                        <input type="text" id="studentName" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="例如：林冠廷">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">學員電話</label>
                        <input type="text" id="studentPhone" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="例如：0900123456">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">學員 Email (必填)</label>
                    <input type="email" id="studentEmail" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="student@example.com">
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">課程編號 (Course ID)</label>
                    <input type="text" id="courseId" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="請輸入 Teachify 系統內的課程 ID">
                </div>
            </section>

            <button onclick="submitEnrollment()" id="submitBtn" class="w-full bg-indigo-600 text-white font-bold py-4 px-6 rounded-xl hover:bg-indigo-700 transform active:scale-[0.98] transition-all shadow-lg shadow-indigo-200">
                立即開通課程權限
            </button>

            <!-- 訊息回饋 -->
            <div id="statusMessage" class="hidden p-4 rounded-xl text-sm font-medium border"></div>
        </div>

        <footer class="mt-10 pt-6 border-t border-slate-100 text-center text-slate-400 text-xs">
            若依然持續出現連線錯誤，建議將此 HTML 檔案部署至 GitHub Pages 或 Netlify 網頁空間。
        </footer>
    </div>

    <script>
        window.onload = () => {
            document.getElementById('apiKey').value = localStorage.getItem('teachify_api_key') || '';
            document.getElementById('endpoint').value = localStorage.getItem('teachify_endpoint') || '';
        };

        async function submitEnrollment() {
            const btn = document.getElementById('submitBtn');
            const status = document.getElementById('statusMessage');
            const useProxy = document.getElementById('useProxy').checked;
            
            let apiKey = document.getElementById('apiKey').value.trim();
            let endpoint = document.getElementById('endpoint').value.trim();
            
            // 自動修正網址
            if (endpoint.endsWith('/graphq')) endpoint += 'l';
            if (!endpoint.endsWith('/graphql') && endpoint !== "") endpoint += '/graphql';

            const studentData = {
                name: document.getElementById('studentName').value.trim(),
                email: document.getElementById('studentEmail').value.trim(),
                phone: document.getElementById('studentPhone').value.trim(),
                courseId: document.getElementById('courseId').value.trim()
            };

            localStorage.setItem('teachify_api_key', apiKey);
            localStorage.setItem('teachify_endpoint', endpoint);

            if (!apiKey || !endpoint || !studentData.email || !studentData.courseId) {
                showMessage('錯誤：請完整填寫 API 配置、Email 與 課程 ID', 'error');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="loading-spinner"></span> 正在處理中...';
            status.classList.add('hidden');

            // 針對 Teachify API 的標準 Enrollment Mutation 結構
            const GQL_MUTATION = {
                query: `
                    mutation CreateEnrollment($email: String!, $courseId: ID!, $name: String, $phone: String) {
                        createEnrollment(input: {
                            email: $email,
                            courseId: $courseId,
                            name: $name,
                            phone: $phone
                        }) {
                            success
                            errors
                            enrollment {
                                id
                            }
                        }
                    }
                `,
                variables: {
                    email: studentData.email,
                    courseId: studentData.courseId,
                    name: studentData.name,
                    phone: studentData.phone
                }
            };

            // 如果勾選使用 Proxy，則加上 cors-anywhere 或類似服務的 Prefix
            const finalEndpoint = useProxy 
                ? `https://cors-anywhere.herokuapp.com/${endpoint}` 
                : endpoint;

            try {
                const response = await fetch(finalEndpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(GQL_MUTATION)
                });

                if (!response.ok) {
                    if (response.status === 403 && useProxy) {
                        throw new Error('CORS Proxy 暫時無法使用（可能需要點擊代理伺服器啟用按鈕），請嘗試取消勾選 Proxy 或部署到網頁空間。');
                    }
                    throw new Error(`伺服器回應錯誤: ${response.status}`);
                }

                const result = await response.json();

                if (result.errors) {
                    throw new Error(result.errors[0].message);
                }

                const responseData = result.data ? result.data.createEnrollment : null;

                if (responseData && responseData.success) {
                    showMessage(`✅ 成功！學員 ${studentData.email} 已加入課程。`, 'success');
                    document.getElementById('studentName').value = '';
                    document.getElementById('studentEmail').value = '';
                    document.getElementById('studentPhone').value = '';
                } else {
                    const errorMsg = responseData?.errors?.join(', ') || '課程 ID 可能不正確或學員已在課程中';
                    showMessage(`❌ 開通失敗：${errorMsg}`, 'error');
                }
            } catch (err) {
                console.error(err);
                showMessage(`⚠️ 連線錯誤：${err.message}`, 'error');
            } finally {
                btn.disabled = false;
                btn.innerText = '立即開通課程權限';
            }
        }

        function showMessage(msg, type) {
            const status = document.getElementById('statusMessage');
            status.innerText = msg;
            status.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'border-red-200', 'bg-green-50', 'text-green-700', 'border-green-200');
            if (type === 'error') {
                status.classList.add('bg-red-50', 'text-red-700', 'border-red-200');
            } else {
                status.classList.add('bg-green-50', 'text-green-700', 'border-green-200');
            }
        }
    </script>
</body>
</html>
