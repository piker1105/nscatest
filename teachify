<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>學員手動開課工具 (GitHub 直接執行版)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .loading-spinner {
            border: 3px solid #f3f3f3;
            border-top: 3px solid #4f46e5;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
            display: inline-block;
            vertical-align: middle;
            margin-right: 8px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-slate-50 min-h-screen py-8 px-4 font-sans">
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden p-6 md:p-10 border border-slate-100">
        <!-- 標題區 -->
        <div class="mb-10 text-center">
            <div class="inline-block p-3 bg-indigo-100 rounded-full mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">冠廷老師專屬：一鍵開課工具</h1>
            <p class="text-slate-500 mt-2">API 資訊已安全嵌入，直接輸入學員資料即可。</p>
        </div>

        <div class="grid grid-cols-1 gap-8">
            <!-- 學員資料區塊 -->
            <section class="space-y-5">
                <div class="flex items-center">
                    <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider border-b-2 border-indigo-500 pb-1">學員與課程資訊</h2>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">學員姓名</label>
                        <input type="text" id="studentName" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="例如：林冠廷">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">學員電話 (選填)</label>
                        <input type="text" id="studentPhone" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="例如：0900123456">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">學員 Email (必填)</label>
                    <input type="email" id="studentEmail" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="student@example.com">
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">課程編號 (Course ID)</label>
                    <input type="text" id="courseId" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-indigo-500 focus:border-indigo-500 border" placeholder="請輸入 Course ID">
                </div>
            </section>

            <button onclick="submitEnrollment()" id="submitBtn" class="w-full bg-indigo-600 text-white font-bold py-4 px-6 rounded-xl hover:bg-indigo-700 transform active:scale-[0.98] transition-all shadow-lg shadow-indigo-200">
                立即開通課程權限
            </button>

            <!-- 訊息回饋 -->
            <div id="statusMessage" class="hidden p-4 rounded-xl text-sm font-medium border leading-relaxed"></div>
        </div>

        <!-- 輔助說明 -->
        <div id="proxyHelp" class="hidden mt-6 p-4 bg-amber-50 rounded-lg border border-amber-200 text-xs text-amber-800">
            <p class="font-bold mb-1">💡 解決連線失敗 (CORS) 步驟：</p>
            <ol class="list-decimal ml-4 space-y-1">
                <li>請先點擊訪問 <a href="https://cors-anywhere.herokuapp.com/corsdemo" target="_blank" class="underline font-bold">此連結</a>。</li>
                <li>點擊頁面中的按鈕 <b>"Request temporary access to the demo server"</b>。</li>
                <li>回到本頁面重新送出即可成功。</li>
            </ol>
        </div>

        <footer class="mt-10 pt-6 border-t border-slate-100 text-center text-slate-400 text-xs italic">
            本工具由 GitHub Pages 託管。API 已預設為冠廷老師的 Teachify 帳號。
        </footer>
    </div>

    <script>
        // 您的專屬配置
        const CONFIG = {
            apiKey: 'key-1617afadff9f6d69488263e4f3cf9df92d441cdb511495ceb34a051c59192c1c',
            endpoint: 'https://vintexercise.teachify.tw/graphql'
        };

        async function submitEnrollment() {
            const btn = document.getElementById('submitBtn');
            const status = document.getElementById('statusMessage');
            const proxyHelp = document.getElementById('proxyHelp');
            
            const studentData = {
                name: document.getElementById('studentName').value.trim(),
                email: document.getElementById('studentEmail').value.trim(),
                phone: document.getElementById('studentPhone').value.trim(),
                courseId: document.getElementById('courseId').value.trim()
            };

            if (!studentData.email || !studentData.courseId) {
                showMessage('錯誤：請填寫 Email 與 課程 ID', 'error');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="loading-spinner"></span> 正在處理中...';
            status.classList.add('hidden');
            proxyHelp.classList.add('hidden');

            const GQL_MUTATION = {
                query: `
                    mutation CreateEnrollment($email: String!, $courseId: ID!, $name: String, $phone: String) {
                        createEnrollment(input: {
                            email: $email,
                            courseId: $courseId,
                            name: $name,
                            phone: $phone
                        }) {
                            success
                            errors
                        }
                    }
                `,
                variables: studentData
            };

            // 備援代理伺服器清單
            const proxies = [
                `https://cors-anywhere.herokuapp.com/`,
                `https://api.allorigins.win/raw?url=`
            ];

            let success = false;

            for (let proxy of proxies) {
                try {
                    const finalUrl = proxy.includes('allorigins') 
                        ? `${proxy}${encodeURIComponent(CONFIG.endpoint)}` 
                        : `${proxy}${CONFIG.endpoint}`;

                    const response = await fetch(finalUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${CONFIG.apiKey}`,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify(GQL_MUTATION)
                    });

                    if (response.status === 403 && proxy.includes('herokuapp')) {
                        // 如果 Heroku 報 403，通常是需要點擊啟用按鈕
                        proxyHelp.classList.remove('hidden');
                        throw new Error('請先啟用代理伺服器權限（見下方說明）。');
                    }

                    if (!response.ok) throw new Error('連線失敗');

                    const result = await response.json();
                    
                    if (result.errors) {
                        throw new Error(result.errors[0].message);
                    }

                    const resData = result.data.createEnrollment;
                    if (resData.success) {
                        showMessage(`✅ 成功！學員 ${studentData.email} 已加入課程。`, 'success');
                        document.getElementById('studentName').value = '';
                        document.getElementById('studentEmail').value = '';
                        document.getElementById('studentPhone').value = '';
                        success = true;
                        break; 
                    } else {
                        throw new Error(resData.errors.join(', '));
                    }
                } catch (err) {
                    console.warn(`使用代理 ${proxy} 失敗:`, err.message);
                    if (proxy === proxies[proxies.length - 1]) {
                        showMessage(`❌ 錯誤：${err.message}`, 'error');
                    }
                }
            }

            btn.disabled = false;
            btn.innerText = '立即開通課程權限';
        }

        function showMessage(msg, type) {
            const status = document.getElementById('statusMessage');
            status.innerHTML = msg;
            status.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'border-red-200', 'bg-green-50', 'text-green-700', 'border-green-200');
            status.classList.add(type === 'error' ? 'bg-red-50' : 'bg-green-50', type === 'error' ? 'text-red-700' : 'text-green-700', type === 'error' ? 'border-red-200' : 'border-green-200');
            status.classList.remove('hidden');
        }
    </script>
</body>
</html>
