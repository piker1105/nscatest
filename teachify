<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>學員手動開課工具 (GAS 終極版)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .loading-spinner {
            border: 3px solid #f3f3f3;
            border-top: 3px solid #4f46e5;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
            display: inline-block;
            vertical-align: middle;
            margin-right: 8px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-slate-50 min-h-screen py-8 px-4 font-sans">
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden p-6 md:p-10 border border-slate-100">
        <div class="mb-10 text-center">
            <div class="inline-block p-3 bg-green-100 rounded-full mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">冠廷老師：GAS 穩定開課工具</h1>
            <p class="text-slate-500 mt-2 text-sm">此版本透過 Google 伺服器轉發，無需代理工具，最為穩定。</p>
        </div>

        <div class="grid grid-cols-1 gap-8">
            <section class="space-y-5">
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider border-b-2 border-green-500 pb-1">學員與課程資訊</h2>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">學員姓名</label>
                        <input type="text" id="studentName" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-green-500 focus:border-green-500 border" placeholder="林冠廷">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">學員電話</label>
                        <input type="text" id="studentPhone" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-green-500 focus:border-green-500 border" placeholder="0900123456">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">學員 Email (必填)</label>
                    <input type="email" id="studentEmail" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-green-500 focus:border-green-500 border" placeholder="student@example.com">
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">課程編號 (Course ID)</label>
                    <input type="text" id="courseId" class="w-full border-slate-300 rounded-lg shadow-sm p-3 focus:ring-green-500 focus:border-green-500 border" placeholder="請貼入 Course ID">
                </div>
            </section>

            <button onclick="submitViaGAS()" id="submitBtn" class="w-full bg-green-600 text-white font-bold py-4 px-6 rounded-xl hover:bg-green-700 transform active:scale-[0.98] transition-all shadow-lg shadow-green-200">
                立即開通課程權限
            </button>

            <div id="statusMessage" class="hidden p-4 rounded-xl text-sm font-medium border leading-relaxed break-all"></div>
        </div>

        <!-- 偵錯資訊區塊（預設隱藏） -->
        <div id="debugInfo" class="hidden mt-6 p-4 bg-slate-100 rounded-lg border border-slate-200 text-[10px] font-mono text-slate-600 overflow-x-auto">
            <p class="font-bold mb-1 uppercase tracking-widest text-slate-400 text-[9px]">系統偵錯日誌</p>
            <div id="debugContent"></div>
        </div>

        <footer class="mt-10 pt-6 border-t border-slate-100 text-center text-slate-400 text-xs italic">
            本工具將請求加密發送至 Google 雲端進行轉發。
        </footer>
    </div>

    <script>
        // 已填入您的 Google Script 部署網址
        const GAS_URL = 'https://script.google.com/macros/s/AKfycbxPbKyUxnDNEW-aFS9AXVuHMynLKkSmQYp2xwgE4tXvAkgDSe8H2AFXXoWiDEWmaew/exec';

        async function submitViaGAS() {
            const btn = document.getElementById('submitBtn');
            const status = document.getElementById('statusMessage');
            const debug = document.getElementById('debugInfo');
            const debugContent = document.getElementById('debugContent');
            
            const studentData = {
                name: document.getElementById('studentName').value.trim() || null,
                email: document.getElementById('studentEmail').value.trim(),
                phone: document.getElementById('studentPhone').value.trim() || null,
                courseId: document.getElementById('courseId').value.trim()
            };

            if (!studentData.email || !studentData.courseId) {
                showMessage('錯誤：請填寫 Email 與 課程 ID', 'error');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="loading-spinner"></span> 正在連線中...';
            status.classList.add('hidden');
            debug.classList.add('hidden');
            debugContent.innerText = '';

            try {
                // 使用 POST 並確保傳送的是純字串化的 JSON
                const response = await fetch(GAS_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'text/plain;charset=utf-8', // GAS 偏好 text/plain 來規避某些 CORS 預檢
                    },
                    body: JSON.stringify(studentData)
                });

                const resultText = await response.text();
                logDebug(`Raw Response: ${resultText}`);

                let result;
                try {
                    result = JSON.parse(resultText);
                } catch (e) {
                    throw new Error(`無法解析回應內容。可能是 GAS 尚未部署為「所有人」。內容：${resultText.substring(0, 100)}`);
                }
                
                // 檢查 Teachify API 回傳的成功狀態
                if (result.data && result.data.createEnrollment && result.data.createEnrollment.success) {
                    showMessage(`✅ 成功！學員 ${studentData.email} 已開通課程。`, 'success');
                    document.getElementById('studentName').value = '';
                    document.getElementById('studentEmail').value = '';
                    document.getElementById('studentPhone').value = '';
                } else if (result.errors) {
                    showMessage(`❌ API 錯誤：${result.errors[0].message}`, 'error');
                } else if (result.data && result.data.createEnrollment) {
                    showMessage(`❌ 系統拒絕：${result.data.createEnrollment.errors.join(', ')}`, 'error');
                } else {
                    showMessage('❌ 收到未知格式的回應。請展開下方偵錯日誌。', 'error');
                    debug.classList.remove('hidden');
                }
                
            } catch (err) {
                showMessage(`❌ 連線失敗：無法讀取結果。<br>這通常是因為 GAS 網址不正確，或是部署權限未設為「所有人」。`, 'error');
                debugContent.innerText = `Error: ${err.message}`;
                debug.classList.remove('hidden');
                console.error(err);
            } finally {
                btn.disabled = false;
                btn.innerText = '立即開通課程權限';
            }
        }

        function showMessage(msg, type) {
            const status = document.getElementById('statusMessage');
            status.innerHTML = msg;
            status.className = `p-4 rounded-xl text-sm font-medium border leading-relaxed ${
                type === 'error' ? 'bg-red-50 text-red-700 border-red-200' : 'bg-green-50 text-green-700 border-green-200'
            }`;
            status.classList.remove('hidden');
        }

        function logDebug(msg) {
            const debugContent = document.getElementById('debugContent');
            debugContent.innerText += `\n[${new Date().toLocaleTimeString()}] ${msg}`;
        }
    </script>
</body>
</html>
